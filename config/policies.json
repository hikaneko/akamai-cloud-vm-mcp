{
  "policies": [
    {
      "handler": {
        "export": "AuditLogInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "eventTypeBase": "com.akamai.cloud-vm-mcp",
          "include": {
            "geolocation": true,
            "ipAddress": true,
            "queryParams": true,
            "user": true
          },
          "samplingRate": 1
        }
      },
      "name": "audit-log-inbound-1",
      "policyType": "audit-log-inbound"
    },
    {
      "handler": {
        "export": "IpAddressRestrictionInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allow": [
            "$env(ALLOWED_IP_1)",
            "$env(ALLOWED_IP_2)"
          ]
        }
      },
      "name": "ip-address-restriction-inbound",
      "policyType": "ip-address-restriction-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/loki-audit-logging)",
        "options": {
          "endpoint": "$env(LOKI_PUSH_URL)",
          "username": "$env(LOKI_PUSH_USERNAME)",
          "password": "$env(LOKI_PUSH_PASSWORD)"
        }
      },
      "name": "loki-audit-logging-inbound",
      "policyType": "custom-code-inbound"
    }
  ]
}